{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "waivers"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "waivers": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "skill_id", "gate", "owner", "reason", "expires_on", "recheck"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "skill_id": {"enum": ["suite", "geo", "geo-discover", "geo-diagnose", "geo-content", "geo-measure"]},
          "gate": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "expires_on": {"type": "string", "format": "date"},
          "recheck": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"skill_id": {"const": "suite"}}, "required": ["skill_id"]},
            "then": {"properties": {"gate": {"enum": ["human-blind-review", "real-platform-benchmark", "commercial-legal-review"]}}},
            "else": {"properties": {"gate": {"enum": ["operations-loop", "release-notes"]}}}
          }
        ]
      }
    }
  }
}
