{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yao.example/geo/registry/skills.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "registry_version", "skills", "workflows"],
  "properties": {
    "protocol_version": {"const": "1.0.0"},
    "registry_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "required_skills", "steps"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
          "required_skills": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
          "steps": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["id", "skill_id", "depends_on"], "properties": {"id": {"type": "string", "pattern": "^[a-z]+$"}, "skill_id": {"type": "string"}, "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}}}
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "active_placeholder", "entry", "summary", "intents", "outputs"],
        "properties": {
          "id": {"type": "string", "pattern": "^(?:geo(?:-[a-z]+)?|seo)$"},
          "status": {"enum": ["active", "pending-implementation", "planned"]},
          "active_placeholder": {"type": "boolean"},
          "entry": {"type": ["string", "null"], "pattern": "\\S"},
          "summary": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "intents": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
          "outputs": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
          "nearest_active": {"type": "string", "pattern": "^(?:geo(?:-[a-z]+)?|seo)$"},
          "required_inputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
          "closest_v0_artifact": {"type": "string", "minLength": 1, "pattern": "\\S"}
        },
        "allOf": [
          {"if": {"properties": {"status": {"const": "active"}}}, "then": {"properties": {"entry": {"type": "string"}}}},
          {"if": {"properties": {"status": {"enum": ["planned", "pending-implementation"]}}}, "then": {"required": ["nearest_active", "required_inputs", "closest_v0_artifact"], "properties": {"entry": {"type": "null"}, "active_placeholder": {"const": false}}}}
        ]
      }
    }
  }
}
