{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yao.example/geo/registry/skills.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "registry_version", "skills", "workflows"],
  "properties": {
    "protocol_version": {"const": "1.0.0"},
    "registry_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "required_skills", "steps"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
          "status": {"enum": ["active", "pending-implementation", "planned"]},
          "required_skills": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
          "steps": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["id", "skill_id", "depends_on"], "properties": {"id": {"type": "string", "pattern": "^[a-z]+$"}, "skill_id": {"type": "string"}, "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}}},
          "orchestration": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nodes"],
            "properties": {
              "nodes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 50,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "kind", "depends_on"],
                  "properties": {
                    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
                    "kind": {"enum": ["skill", "approval", "external-publication", "external-observation"]},
                    "skill_id": {"type": "string"},
                    "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
                    "request": {"type": "string", "minLength": 1, "maxLength": 500},
                    "evidence_schema": {"enum": ["publication-receipt", "engine-observation-bundle"]}
                  },
                  "allOf": [
                    {"if": {"properties": {"kind": {"const": "skill"}}}, "then": {"required": ["skill_id"]}},
                    {"if": {"properties": {"kind": {"const": "approval"}}}, "then": {"required": ["request"]}},
                    {"if": {"properties": {"kind": {"enum": ["external-publication", "external-observation"]}}}, "then": {"required": ["evidence_schema"]}}
                  ]
                }
              }
            }
          },
          "required_inputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
          "closest_v0_artifact": {"type": "string", "minLength": 1, "pattern": "\\S"}
        },
        "allOf": [
          {"if": {"properties": {"status": {"enum": ["planned", "pending-implementation"]}}}, "then": {"required": ["required_inputs", "closest_v0_artifact"]}}
        ]
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "active_placeholder", "entry", "summary", "intents", "outputs", "positive_examples", "negative_examples", "input_artifacts", "output_artifacts", "permissions", "side_effects", "preconditions", "execution", "routing"],
        "properties": {
          "id": {"type": "string", "pattern": "^(?:geo(?:-[a-z]+)?|seo)$"},
          "status": {"enum": ["active", "pending-implementation", "planned"]},
          "active_placeholder": {"type": "boolean"},
          "entry": {"type": ["string", "null"], "pattern": "\\S"},
          "summary": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "intents": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
          "outputs": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
          "positive_examples": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 2, "pattern": "\\S"}},
          "negative_examples": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 2, "pattern": "\\S"}},
          "input_artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifactContract"}},
          "output_artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifactContract"}},
          "permissions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["filesystem", "network", "shell", "approval_required"],
            "properties": {
              "filesystem": {"enum": ["read-only", "read-write-output", "external-write"]},
              "network": {"enum": ["forbid", "explicit-public-http-only", "external-service"]},
              "shell": {"enum": ["forbid", "bash"]},
              "approval_required": {"type": "boolean"}
            }
          },
          "side_effects": {"type": "array", "uniqueItems": true, "items": {"enum": ["writes-artifacts", "reads-approved-public-http", "publishes-external-content"]}},
          "preconditions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
          "execution": {
            "type": "object",
            "additionalProperties": false,
            "required": ["executor", "timeout_seconds", "max_attempts", "idempotent"],
            "properties": {
              "executor": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]*$"},
              "timeout_seconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 3600},
              "max_attempts": {"type": "integer", "minimum": 0, "maximum": 5},
              "idempotent": {"type": "boolean"}
            }
          },
          "routing": {
            "type": "object",
            "additionalProperties": false,
            "required": ["semantic_threshold", "ambiguity_margin", "threshold_version"],
            "properties": {
              "semantic_threshold": {"type": "number", "minimum": 0, "maximum": 1},
              "ambiguity_margin": {"type": "number", "minimum": 0, "maximum": 1},
              "threshold_version": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
            }
          },
          "nearest_active": {"type": "string", "pattern": "^(?:geo(?:-[a-z]+)?|seo)$"},
          "required_inputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
          "closest_v0_artifact": {"type": "string", "minLength": 1, "pattern": "\\S"}
        },
        "allOf": [
          {"if": {"properties": {"status": {"const": "active"}}}, "then": {"properties": {"entry": {"type": "string"}}}},
          {"if": {"properties": {"status": {"enum": ["planned", "pending-implementation"]}}}, "then": {"required": ["nearest_active", "required_inputs", "closest_v0_artifact"], "properties": {"entry": {"type": "null"}, "active_placeholder": {"const": false}}}}
        ]
      }
    }
  },
  "$defs": {
    "artifactContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "schema", "required"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
        "schema": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
        "required": {"type": "boolean"}
      }
    }
  }
}
