{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yao.example/geo/schemas/publication-handoff.schema.json",
  "title": "Publication Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "run_id", "candidate_digest", "deployment_requirements", "observation_window", "query_panel", "status", "baseline_digest"],
  "properties": {
    "protocol_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "\\S"},
    "candidate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "deployment_requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}},
    "observation_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["days", "starts_after"],
      "properties": {
        "days": {"type": "integer", "minimum": 1, "maximum": 365},
        "starts_after": {"const": "verified external publication"}
      }
    },
    "query_panel": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}},
    "status": {"const": "awaiting_external_publication"},
    "baseline_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
