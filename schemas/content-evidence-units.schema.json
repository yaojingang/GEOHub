{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yao.example/geo/schemas/content-evidence-units.schema.json",
  "title": "Content Evidence Units",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "run_id", "mode", "effect_guarantee", "units"],
  "properties": {
    "protocol_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "mode": {"enum": ["title", "explainer", "comparison", "ranking", "page-blueprint", "refine", "article-friendly"]},
    "effect_guarantee": {"const": false},
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unit_id", "lineage_type", "text", "status", "evidence_ids", "research_source_ids", "causal_status", "limitations"],
        "properties": {
          "unit_id": {"type": "string", "pattern": "^unit-[0-9a-f]{12}$"},
          "lineage_type": {"enum": ["input-evidence", "source-preserved", "research-method", "operational-guidance", "evidence-gap"]},
          "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "status": {"enum": ["provided", "unverified", "guidance", "blocked"]},
          "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}},
          "research_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:P\\d{2}|D\\d{2})$"}},
          "causal_status": {"enum": ["causal-estimate", "observational", "benchmark-conditional", "governance", "mixed", "not-applicable"]},
          "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}}
        },
        "allOf": [
          {
            "if": {"properties": {"lineage_type": {"const": "input-evidence"}}},
            "then": {"properties": {"evidence_ids": {"minItems": 1}, "research_source_ids": {"maxItems": 0}, "status": {"const": "provided"}}}
          },
          {
            "if": {"properties": {"lineage_type": {"const": "research-method"}}},
            "then": {"properties": {"evidence_ids": {"maxItems": 0}, "research_source_ids": {"minItems": 1}, "status": {"const": "guidance"}}}
          }
        ]
      }
    }
  }
}
