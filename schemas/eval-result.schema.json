{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yao.example/geo/schemas/eval-result.schema.json",
  "title": "Evaluation Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "suite_id", "created_at", "execution_mode", "environments", "budget", "runs", "summary", "human_review"],
  "properties": {
    "protocol_version": {"const": "1.0.0"},
    "suite_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "execution_mode": {"enum": ["deterministic", "command", "provider"]},
    "environments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "candidate"],
      "properties": {"baseline": {"$ref": "#/$defs/environment"}, "candidate": {"$ref": "#/$defs/environment"}}
    },
    "budget": {"type": "object", "additionalProperties": false, "required": ["max_cost_usd", "estimated_max_cost_usd", "actual_cost_usd", "planned_calls", "private_provider_approval_digest"], "properties": {"max_cost_usd": {"type": ["number", "null"], "minimum": 0}, "estimated_max_cost_usd": {"type": ["number", "null"], "minimum": 0}, "actual_cost_usd": {"type": "number", "minimum": 0}, "planned_calls": {"type": "integer", "minimum": 2, "maximum": 100}, "private_provider_approval_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}},
    "runs": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/run"}},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_count", "private_holdout_case_count", "pair_count", "baseline_pass_rate", "with_skill_pass_rate", "absolute_delta", "citation_support", "fabricated_citations", "semantic_digest", "failure_taxonomy"],
      "properties": {
        "case_count": {"type": "integer", "minimum": 1},
        "private_holdout_case_count": {"type": "integer", "minimum": 0},
        "pair_count": {"type": "integer", "minimum": 1},
        "baseline_pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "with_skill_pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "absolute_delta": {"type": "number", "minimum": -1, "maximum": 1},
        "citation_support": {"type": "number", "minimum": 0, "maximum": 1},
        "fabricated_citations": {"type": "integer", "minimum": 0},
        "semantic_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "failure_taxonomy": {"type": "object", "additionalProperties": false, "required": ["route", "contract", "evidence", "factuality", "relevance", "style", "safety", "runtime"], "properties": {"route": {"type": "integer", "minimum": 0}, "contract": {"type": "integer", "minimum": 0}, "evidence": {"type": "integer", "minimum": 0}, "factuality": {"type": "integer", "minimum": 0}, "relevance": {"type": "integer", "minimum": 0}, "style": {"type": "integer", "minimum": 0}, "safety": {"type": "integer", "minimum": 0}, "runtime": {"type": "integer", "minimum": 0}}}
      }
    },
    "human_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewed_pairs", "pending_pairs", "with_skill_win_rate", "second_reviewer_coverage", "cohen_kappa"],
      "properties": {
        "status": {"enum": ["missing-evidence", "pending", "completed", "warn"]},
        "reviewed_pairs": {"type": "integer", "minimum": 0},
        "pending_pairs": {"type": "integer", "minimum": 0},
        "with_skill_win_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "second_reviewer_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "cohen_kappa": {"type": ["number", "null"], "minimum": -1, "maximum": 1}
      }
    }
  },
  "$defs": {
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "status", "wheel_sha256", "python_version", "platform", "dependency_digest"],
      "properties": {"label": {"enum": ["baseline", "candidate"]}, "status": {"enum": ["verified", "missing-evidence"]}, "wheel_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "python_version": {"type": ["string", "null"]}, "platform": {"type": ["string", "null"]}, "dependency_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens", "estimated"],
      "properties": {"input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}, "total_tokens": {"type": "integer", "minimum": 0}, "estimated": {"type": "boolean"}}
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "variant", "execution_kind", "provider", "model", "output", "metrics", "latency_ms", "usage", "cost_usd", "rubric"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "variant": {"enum": ["baseline", "with_skill"]},
        "execution_kind": {"enum": ["recorded_fixture", "command", "model"]},
        "provider": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "output": {"type": "object"},
        "metrics": {"type": "object"},
        "latency_ms": {"type": "integer", "minimum": 0},
        "usage": {"$ref": "#/$defs/usage"},
        "cost_usd": {"type": "number", "minimum": 0},
        "rubric": {"type": "string", "minLength": 1}
      }
    }
  }
}
