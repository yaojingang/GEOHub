{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yao.example/geo/schemas/strategy-candidates.schema.json",
  "title": "Strategy Candidates",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "run_id", "candidates"],
  "properties": {
    "protocol_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^run-[A-Za-z0-9._-]+$"},
    "candidates": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "action_diff", "expected_impact", "evidence_ids", "status", "fidelity", "semantic_digest"], "properties": {"candidate_id": {"type": "string", "pattern": "^candidate-[1-9][0-9]*$"}, "action_diff": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}}, "expected_impact": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number"}}, "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}}, "status": {"const": "offline-proposed"}, "fidelity": {"type": "object", "additionalProperties": false, "required": ["passed", "checks"], "properties": {"passed": {"type": "boolean"}, "checks": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "boolean"}}}}, "semantic_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
  }
}
