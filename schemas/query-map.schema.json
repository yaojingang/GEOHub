{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yao.example/geo/schemas/query-map.schema.json",
  "title": "Query Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "run_id", "queries"],
  "properties": {
    "protocol_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "semantic_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "status", "provider", "model", "prompt_digest", "token_count", "cost_usd", "failures"],
      "properties": {
        "mode": {"enum": ["legacy", "deterministic", "research", "provider"]},
        "status": {"enum": ["completed", "degraded"]},
        "provider": {"type": ["string", "null"], "minLength": 1},
        "model": {"type": ["string", "null"], "minLength": 1},
        "prompt_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "token_count": {"type": "integer", "minimum": 0},
        "cost_usd": {"type": "number", "minimum": 0},
        "failures": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query_id", "question", "intent", "audience", "scenario", "parent_query_id", "rewrites", "evidence_status"],
        "properties": {
          "query_id": {"type": "string", "pattern": "\\S"},
          "question": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "intent": {"enum": ["learn", "compare", "evaluate", "act"]},
          "audience": {"type": "string", "pattern": "\\S"},
          "scenario": {"type": "string", "pattern": "\\S"},
          "parent_query_id": {"type": ["string", "null"], "pattern": "\\S"},
          "rewrites": {
            "type": "object",
            "additionalProperties": false,
            "required": ["standalone", "retrieval", "evidence"],
            "properties": {
              "standalone": {"type": "string", "pattern": "\\S"},
              "retrieval": {"type": "string", "pattern": "\\S"},
              "evidence": {"type": "string", "pattern": "\\S"}
            }
          },
          "evidence_status": {"enum": ["provided", "missing"]},
          "generator": {"enum": ["template_baseline", "question_graph", "hypothetical_document"]},
          "novelty": {"type": "number", "minimum": 0, "maximum": 1},
          "score_components": {
            "type": "object",
            "additionalProperties": false,
            "required": ["coverage", "relevance", "novelty", "evidence", "business_fit"],
            "properties": {
              "coverage": {"type": "number", "minimum": 0, "maximum": 1},
              "relevance": {"type": "number", "minimum": 0, "maximum": 1},
              "novelty": {"type": "number", "minimum": 0, "maximum": 1},
              "evidence": {"type": "number", "minimum": 0, "maximum": 1},
              "business_fit": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        }
      }
    }
  }
}
