{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yao.example/geo/schemas/experiment-plan.schema.json",
  "title": "Strategy Experiment Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "run_id", "candidate_id", "baseline", "metric_weights", "observation_window_days", "success_rule", "early_stop"],
  "properties": {"protocol_version": {"const": "1.0.0"}, "run_id": {"type": "string", "pattern": "^run-[A-Za-z0-9._-]+$"}, "candidate_id": {"type": "string", "pattern": "^candidate-[1-9][0-9]*$"}, "baseline": {"type": "object", "additionalProperties": false, "required": ["semantic_digest", "query_panel", "metrics"], "properties": {"semantic_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "query_panel": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}}, "metrics": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number"}}}}, "metric_weights": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}}, "observation_window_days": {"type": "integer", "minimum": 1, "maximum": 365}, "success_rule": {"type": "string", "pattern": "\\S"}, "early_stop": {"type": "object", "additionalProperties": false, "required": ["max_consecutive_no_improvement", "fidelity_failure_stops"], "properties": {"max_consecutive_no_improvement": {"type": "integer", "minimum": 1}, "fidelity_failure_stops": {"type": "boolean"}}}}
}
